+// Cache hasil image processing. Dibatasi berdasarkan byte agar tidak menghabiskan RAM.
+// Bisa diatur melalui env: IMAGE_CACHE_MAX_BYTES / IMAGE_CACHE_TTL_MS.
+const IMAGE_CACHE_MAX_BYTES = Math.max(0, Number(process.env.IMAGE_CACHE_MAX_BYTES ?? 24 * 1024 * 1024));
+const IMAGE_CACHE_TTL_MS = Math.max(1_000, Number(process.env.IMAGE_CACHE_TTL_MS ?? 10 * 60_000));
+const IMAGE_CACHE_MAX_ENTRIES = 160;
+type CachedImage = { result: ImageResult; expiresAt: number; bytes: number };
+const imageCache = new Map<string, CachedImage>();
+const imageInflight = new Map<string, Promise<ImageResult>>();
+let imageCacheBytes = 0;
+
+function cacheDelete(key: string) {
+  const item = imageCache.get(key);
+  if (!item) return;
+  imageCacheBytes -= item.bytes;
+  imageCache.delete(key);
+}
+function cacheGet(key: string): ImageResult | undefined {
+  const item = imageCache.get(key);
+  if (!item) return;
+  if (item.expiresAt <= Date.now()) { cacheDelete(key); return; }
+  // LRU: pindahkan entry yang dipakai ke ujung Map.
+  imageCache.delete(key);
+  imageCache.set(key, item);
+  return item.result;
+}
+function cachePut(key: string, result: ImageResult) {
+  const bytes = result.buffer.byteLength;
+  if (!IMAGE_CACHE_MAX_BYTES || bytes > IMAGE_CACHE_MAX_BYTES) return;
+  cacheDelete(key);
+  while (imageCache.size >= IMAGE_CACHE_MAX_ENTRIES || imageCacheBytes + bytes > IMAGE_CACHE_MAX_BYTES) {
+    const oldest = imageCache.keys().next();
+    if (oldest.done) break;
+    cacheDelete(oldest.value);
+  }
+  imageCache.set(key, { result, bytes, expiresAt: Date.now() + IMAGE_CACHE_TTL_MS });
+  imageCacheBytes += bytes;
+}
+function imageCacheKey(input: Uint8Array, opts: ImageOptions): string {
+  const mode = opts.mode ?? (opts.height ? "cover" : "width");
+  const format = opts.format ?? "jpeg";
+  const normalized = `${mode}|${opts.width}|${opts.height ?? opts.width}|${format}|${opts.quality ?? 80}|img-v1`;
+  return createHash("sha256").update(normalized).update("\0").update(input).digest("hex");
+}
+/** Statistik sederhana untuk observability; tidak menyertakan konten gambar. */
+export function getImageCacheStats() {
+  return { entries: imageCache.size, bytes: imageCacheBytes, inflight: imageInflight.size, maxBytes: IMAGE_CACHE_MAX_BYTES };
+}
+export function clearImageCache() {
+  imageCache.clear(); imageInflight.clear(); imageCacheBytes = 0;
+}
