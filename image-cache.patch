+/**
+ * Image processing dengan bounded LRU + TTL + in-flight dedup.
+ * Catatan: hasil buffer dibagikan antar pemanggil. Perlakukan sebagai immutable.
+ */
+export async function processImage(input: Uint8Array, opts: ImageOptions): Promise<ImageResult> {
+  if (!input?.length) throw new Error("gambar kosong");
+  const key = imageCacheKey(input, opts);
+  const hit = cacheGet(key);
+  if (hit) return hit;
+  const active = imageInflight.get(key);
+  if (active) return active;
+  const task = processImageUncached(input, opts).then((result) => {
+    cachePut(key, result);
+    return result;
+  }).finally(() => imageInflight.delete(key));
+  imageInflight.set(key, task);
+  return task;
+}
